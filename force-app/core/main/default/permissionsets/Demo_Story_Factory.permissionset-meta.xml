<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Demo Story Factory</label>
    <description>Additive permission set for the Demo Story Factory (Demo_Story__c / Demo_Stage__c + deploy service). Separate from Demo Studio Admin so the existing unified-profile generator is untouched.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Demo_Story__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Demo_Stage__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><field>Demo_Story__c.Industry__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Brand__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Brand_Domain__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Primary_Color__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Accent_Color__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Logo_URL__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Persona__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Config_JSON__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Status__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Connector_Id__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Data_Space__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Profile_Data_Graph__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Deployed_Artifacts__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Story__c.Last_Deployed__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Stage__c.Stage_Type__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Stage__c.Channel__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Stage__c.Sort_Order__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Stage__c.Surface__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Stage__c.Content_JSON__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <tabSettings>
        <tab>Demo_Story__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <classAccesses>
        <apexClass>DemoStudioDeployService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>StoryEmailPreviewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <pageAccesses>
        <apexPage>StoryEmailPreview</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
</PermissionSet>
