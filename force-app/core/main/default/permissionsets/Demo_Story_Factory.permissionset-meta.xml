<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>2-Way Simulators</label>
    <description>Additive permission set for the 2-Way Simulators tool (Two_Way_Simulator__c + Story Studio + preview + brand kits). Separate from Demo Studio Admin and from StoryStudio.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>StoryEmailPreviewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DemoBrandKitService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DemoStoryGenerator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Two_Way_Simulator__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Demo_Theme__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Demo_Persona__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Channel__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Config_JSON__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Brand__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Brand_Kit__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Industry__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Two_Way_Simulator__c.Persona__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Theme__c.Primary_Color__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Theme__c.Accent_Color__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Theme__c.Logo_URL__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Theme__c.Secondary_Logo_URL__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Theme__c.Background_Gradient__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Persona__c.First_Name__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Persona__c.Last_Name__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Demo_Persona__c.Title__c</field><editable>false</editable><readable>true</readable></fieldPermissions>
