<apex:page controller="WebExperiencePreviewController" showHeader="false" sidebar="false"
    standardStylesheets="false" applyHtmlTag="true" applyBodyTag="true" cache="false"
    docType="html-5.0">
<style>
    html, body { margin: 0; padding: 0; height: 100%; background: #fff; }
    #sim { border: 0; width: 100%; height: 100vh; display: block; }
    #shim { display: none; }
    #err { font-family: monospace; padding: 16px; color: #611; white-space: pre-wrap; }
</style>
<div id="shim"></div>
<iframe id="sim" title="Adaptive Web preview"></iframe>
<!-- Ported EG content engine (verbatim). Loaded before the bootstrap so its
     function declarations are global by the time we call them. -->
<script src="{!URLFOR($Resource.demoWebEngine)}"></script>
<script>
    (function () {
        // Flavor picks the template; the engine (demoWebEngine) drives both. 'commerce'
        // = storefront (demoWebCommerceTemplate), else the default services layout.
        var FLAVOR = '{!flavor}';
        var SERVICES_TPL_URL = '{!URLFOR($Resource.demoWebTemplate)}';
        var COMMERCE_TPL_URL = '{!URLFOR($Resource.demoWebCommerceTemplate)}';
        var CFG, TPL_URL = (FLAVOR === 'commerce') ? COMMERCE_TPL_URL : SERVICES_TPL_URL;
        var ICON_URL = '{!URLFOR($Resource.demoWebAgentIcon)}';
        var AGENT_BLUE = '#0b5cab';
        try { CFG = JSON.parse('{!JSENCODE(configJson)}'); } catch (e) { CFG = { dom: {}, form: {} }; }

        // Build a self-contained agent-icon data URI from the demoWebAgentIcon SVG:
        // the monochrome Agentforce astro recolored blue on a white circle (matching
        // the official Agentforce callout). Baked as a data: URI so it renders in the
        // cross-domain preview iframe AND survives export to a standalone HTML file
        // (no Cloudinary / Salesforce-domain dependency). Replaces the engine's
        // broken relative agentforce-astro-agent.png reference.
        function buildAgentIcon(svgText) {
            // Astro inherits the demo's brand primary color (falls back to Agentforce
            // blue). White circle stays, matching the official callout.
            var color = (CFG && CFG.form && CFG.form.adaptivePrimaryColor) || AGENT_BLUE;
            var inner = svgText.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
            var wrapped = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'>"
                + "<circle cx='20' cy='20' r='20' fill='#ffffff'/>"
                + "<g transform='translate(6,6) scale(0.875)' fill='" + color + "'>" + inner + "</g></svg>";
            return 'data:image/svg+xml;base64,' + btoa(wrapped);
        }

        // --- commerce flavor: storefront-only token resolution -------------------
        // These tokens live ONLY in demoWebCommerceTemplate and are NOT in the shared
        // engine's fixed token set, so they are filled here from the record's Config
        // (routed to CFG.dom by the controller) with sensible defaults. Each maps to a
        // field the Website Studio exposes for commerce records (editable like the rest).
        function escCommerce(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        function cfgVal(key) {
            var d = (CFG && CFG.dom) || {}, f = (CFG && CFG.form) || {};
            var v = (d[key] != null && String(d[key]).trim()) ? d[key] : f[key];
            return (v != null && String(v).trim()) ? String(v) : null;
        }
        // Resolve persona/brand/agent tokens in commerce copy. The shared engine's own
        // token pass already ran before commerceFill, so tokens inside a commerce FIELD
        // value (e.g. an authored "Still thinking it over, [[CUSTOMER_FIRST_NAME]]?")
        // would otherwise survive unresolved. Mirror the engine's interpolation here,
        // sourcing from CFG.form (where the controller mirrors brand/persona/agent).
        function resolveCommerceTokens(s) {
            var f = (CFG && CFG.form) || {};
            var fn = f.adaptivePersonaFirstName || '', bn = f.adaptiveBrandName || '',
                an = f.adaptiveAgentName || '';
            return String(s == null ? '' : s)
                .replace(/\[\[CUSTOMER_FIRST_NAME\]\]/g, fn)
                .replace(/\$\{firstName\}/g, fn)
                .replace(/\$\{brandName\}/g, bn)
                .replace(/\$\{agentName\}/g, an)
                .replace(/\s{2,}/g, ' ').trim();
        }
        // Read a field from CFG (dom first, then form). Card fields live in CFG.dom.
        function gvCommerce(id) {
            var d = (CFG && CFG.dom) || {}, f = (CFG && CFG.form) || {};
            var v = (d[id] != null && String(d[id]).trim()) ? d[id] : f[id];
            return (v != null) ? String(v) : '';
        }
        // Build the 3-product recommendation grid for the overlay. Mirrors the engine's
        // card markup/classes (so the template CSS applies) but leads with a PRODUCT
        // IMAGE (card{n}_image), falling back to the icon circle when no image is set.
        function buildCommerceCards() {
            var esc = function (s) { return escCommerce(resolveCommerceTokens(s)); };
            var addLabel = cfgVal('commerceAddToBag') || 'Add to bag';
            var html = '<div class="floating-cards-container items-stretch">';
            for (var n = 1; n <= 3; n++) {
                var p = 'card' + n + '_';
                var title = gvCommerce(p + 'title');
                if (!title) continue;
                var b = gvCommerce(p + 'bestMatch');
                var rec = (b === 'true' || b === '1');
                var img = gvCommerce(p + 'image');
                var icon = gvCommerce(p + 'icon') || 'fa-bag-shopping';
                var badge = esc(gvCommerce(p + 'badgeText') || 'Best match');
                var tag = esc(gvCommerce(p + 'tag'));
                var bundle = esc(gvCommerce(p + 'bundle'));
                var cta = esc(gvCommerce(p + 'cta') || addLabel);
                html += '<div class="solution-card flex flex-col h-full' + (rec ? ' solution-card-recommended' : '') + '"' + (rec ? ' style="border-width:2px;border-color:var(--brand);box-shadow:0 20px 60px rgba(0,0,0,0.18);"' : '') + '>';
                if (rec) html += '<div class="recommended-badge"><i class="fas fa-star" aria-hidden="true"></i><span>' + badge + '</span></div>';
                if (img) {
                    html += '<div class="w-full overflow-hidden rounded-t-2xl" style="aspect-ratio:16/10;background:#f1f5f9;">'
                        + '<img src="' + escCommerce(img) + '" alt="" class="h-full w-full object-cover" loading="lazy"/></div>';
                }
                html += '<div class="flex flex-col flex-grow min-h-0"><div class="card-header shrink-0' + (rec ? ' pr-24 sm:pr-28' : '') + '">';
                html += '<div class="flex items-start justify-between gap-3 mb-1"><div class="flex items-center min-w-0">';
                if (!img) {
                    html += '<div class="solution-icon shrink-0" style="background-color: color-mix(in srgb, var(--brand) 15%, transparent); color: var(--brand);"><i class="fas ' + escCommerce(icon) + '" aria-hidden="true"></i></div>';
                }
                html += '<div class="' + (img ? '' : 'ml-3 ') + 'min-w-0">';
                if (tag) html += '<p class="text-xs uppercase tracking-wide font-semibold ' + (rec ? 'text-brand' : 'text-gray-500') + ' mb-1">' + tag + '</p>';
                html += '<h3 class="text-xl font-bold text-gray-900 leading-snug">' + esc(title) + '</h3>';
                html += '</div></div></div></div>';
                html += '<div class="card-body flex flex-col flex-grow pt-0 min-h-0"><div class="flex flex-col flex-grow min-h-0"><div class="metrics-grid">';
                for (var m = 1; m <= 3; m++) {
                    var lab = gvCommerce(p + 'm' + m + '_label'), val = gvCommerce(p + 'm' + m + '_value');
                    if (!lab && !val) continue;
                    html += '<div class="metric-item"><div class="metric-label">' + esc(lab) + '</div><div class="metric-value-row ' + (rec ? 'text-brand' : 'text-gray-900') + '"><span class="metric-value-core">' + esc(val) + '</span></div></div>';
                }
                html += '</div><div class="divider"></div><div class="features-section"><h4 class="features-title">Highlights</h4><ul class="features-list">';
                for (var fi = 1; fi <= 4; fi++) {
                    var ft = gvCommerce(p + 'f' + fi);
                    if (!ft) continue;
                    html += '<li class="feature-item"><i class="fas fa-check-circle ' + (rec ? 'text-brand' : 'text-gray-400') + '" aria-hidden="true"></i><span>' + esc(ft) + '</span></li>';
                }
                html += '</ul></div>';
                if (bundle) html += '<div class="bundle-highlight"><i class="fas fa-lightbulb text-brand" aria-hidden="true"></i><span>' + bundle + '</span></div>';
                html += '</div><div class="mt-auto pt-4 w-full shrink-0"><button type="button" data-cart-add class="card-cta-btn mt-0"><i class="fas fa-bag-shopping" style="margin-right:8px" aria-hidden="true"></i>' + cta + '</button></div>';
                html += '</div></div></div>';
            }
            html += '</div>';
            return html;
        }
        // Product catalog grid for the cold-browse section. catalogProducts is a JSON
        // array [{name,price,image,tag}] stored in the record config; shoppers scroll
        // this like a real PLP before the agent engages.
        function buildCatalog() {
            // Prefer the per-product fields (catalogN_*, row-editable); fall back to the
            // legacy catalogProducts JSON blob.
            var list = [];
            for (var ci = 1; ci <= 12; ci++) {
                var nm = gvCommerce('catalog' + ci + '_name');
                var im = gvCommerce('catalog' + ci + '_image');
                if (nm || im) list.push({ name: nm, image: im, price: gvCommerce('catalog' + ci + '_price'), tag: gvCommerce('catalog' + ci + '_tag') });
            }
            if (!list.length) {
                var raw = gvCommerce('catalogProducts');
                if (raw) { try { list = JSON.parse(raw); } catch (e) { list = []; } }
            }
            if (!Array.isArray(list) || !list.length) return '';
            var esc = function (s) { return escCommerce(resolveCommerceTokens(s)); };
            var html = '<div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">';
            list.forEach(function (p) {
                if (!p || !p.name) return;
                html += '<div class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm ring-1 ring-slate-100 transition-shadow hover:shadow-md">';
                html += '<div class="relative aspect-square w-full overflow-hidden bg-slate-100">';
                if (p.image) html += '<img src="' + escCommerce(p.image) + '" alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105"/>';
                html += '<button type="button" data-cart-add class="absolute bottom-2 right-2 flex h-9 w-9 items-center justify-center rounded-full text-white shadow-md" style="background-color: var(--brand)" aria-label="Add to bag"><i class="fas fa-plus text-sm" aria-hidden="true"></i></button>';
                html += '</div><div class="flex flex-1 flex-col p-4">';
                if (p.tag) html += '<p class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-slate-400">' + esc(p.tag) + '</p>';
                html += '<h3 class="text-sm font-semibold leading-snug text-slate-900">' + esc(p.name) + '</h3>';
                if (p.price) html += '<p class="mt-1 text-sm font-bold" style="color: var(--brand)">' + esc(p.price) + '</p>';
                html += '</div></div>';
            });
            html += '</div>';
            return html;
        }
        function commerceFill(html) {
            // Retail, lightly personalized fallbacks; per-scenario webDefaults override
            // these with copy tailored to the product (apparel vs electronics, etc.).
            var MAP = [
                ['CART_COUNT', 'commerceCartCount', '2'],
                ['CART_BANNER_TITLE', 'commerceCartBannerTitle', 'Looks like you forgot something 👀'],
                ['CART_BANNER_SUBTITLE', 'commerceCartBannerSubtitle', 'Your picks are still in your bag — come back and make them yours before they sell out.'],
                ['CART_CTA', 'commerceCartCta', 'Complete checkout'],
                ['ADD_TO_BAG_LABEL', 'commerceAddToBag', 'Add to bag'],
                ['CATALOG_HEADING', 'catalogHeading', 'Shop the latest'],
                ['CATALOG_SUBTITLE', 'catalogSubtitle', 'Browse what’s trending now — add favorites to your bag as you go.']
            ];
            MAP.forEach(function (row) {
                var val = cfgVal(row[1]);
                if (val == null) val = row[2];
                html = html.split('[[' + row[0] + ']]').join(escCommerce(resolveCommerceTokens(val)));
            });
            html = html.split('[[COMMERCE_CARDS_GRID_HTML]]').join(buildCommerceCards());
            html = html.split('[[PRODUCT_CATALOG_HTML]]').join(buildCatalog());
            return html;
        }

        // Build the hidden shim inputs the engine reads via getElementById. Only the
        // ids present in CFG.dom are created; everything else is absent, so the
        // engine falls back to its per-industry defaults.
        var shim = document.getElementById('shim');
        var dom = CFG.dom || {};
        Object.keys(dom).forEach(function (id) {
            var v = dom[id];
            var el = document.createElement('input');
            // Boolean fields (e.g. card*_bestMatch) must be checkboxes — the engine
            // reads them via .checked, so a hidden text input never registers.
            if (v === true || v === false || v === 'true' || v === 'false') {
                el.type = 'checkbox';
                el.checked = (v === true || v === 'true');
                el.style.display = 'none';
            } else {
                el.type = 'hidden';
                el.value = v == null ? '' : String(v);
            }
            el.id = id;
            shim.appendChild(el);
        });

        var lastHtml = '';
        function downloadHtml(h) {
            if (!h) return;
            try {
                var brand = (CFG.dom && CFG.dom.adaptiveBrandName) || 'personalized-website';
                var fname = brand.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '-website.html';
                var blob = new Blob([h], { type: 'text/html;charset=utf-8' });
                var durl = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = durl; a.download = fname;
                document.body.appendChild(a); a.click(); document.body.removeChild(a);
                setTimeout(function () { URL.revokeObjectURL(durl); }, 2000);
            } catch (e) {}
        }

        function fail(msg) {
            var f = document.getElementById('sim');
            f.setAttribute('srcdoc', '<div id="err">' + msg + '</div>');
        }

        Promise.all([
            fetch(TPL_URL).then(function (r) { return r.text(); }),
            fetch(ICON_URL).then(function (r) { return r.text(); }).catch(function () { return ''; })
        ])
            .then(function (parts) {
                var tpl = parts[0], iconSvg = parts[1];
                var html;
                try {
                    // The engine prefers live DOM .value (the shim) and takes
                    // colors/logo/images from the formData arg (CFG.form).
                    html = applyAdaptiveWebTemplateReplacements(tpl, CFG.form || {});
                } catch (e) {
                    fail('Engine error: ' + (e && e.message ? e.message : e));
                    return;
                }
                // Inline the recolored agent icon in place of the broken PNG ref.
                if (iconSvg) {
                    try {
                        var icon = buildAgentIcon(iconSvg);
                        html = html.replace(/src="[^"]*agentforce-astro-agent\.png"/g, 'src="' + icon + '"');
                    } catch (e) { /* leave the original src if anything fails */ }
                }

                // Commerce flavor adds storefront-only tokens the SHARED engine does
                // not know (its [[TOKEN]] set is fixed). Resolve them here in a thin
                // post-pass from the record's Config (CFG.dom / CFG.form) with
                // defaults, so every storefront element stays editable in the config
                // pane exactly like the rest of the tool. The engine is untouched.
                if (FLAVOR === 'commerce') {
                    try { html = commerceFill(html); } catch (e) {}
                }

                // Self-contained .html export (resolved sim, agent icon inlined as a
                // data URI). Triggered by the Studio via a 'web-download' postMessage
                // (no extra tab) or by ?download=1 (direct URL). Blob download works
                // here (VF page, not LWS).
                lastHtml = html;
                var qs = new URLSearchParams(window.location.search);
                if (qs.get('download') === '1') { downloadHtml(html); return; }

                var f = document.getElementById('sim');
                f.setAttribute('srcdoc', html);

                // The adaptive sim is driven by a parent-window postMessage harness
                // (adaptive-restore-state in / adaptive-sim-state out). With no parent
                // it boots to state 0 (cold home, agent hidden). Drive it: default to
                // the agent being visible, and relay 'web-sim-drive' from the Studio
                // (Cold / Agent / Adapted controls) up top.
                var VIEWS = {
                    cold:     { lastReportedState: 0 },
                    category: { lastReportedState: 1 },
                    agent:    { lastReportedState: 1, chatOpen: true, categoryChatGreetingSent: true },
                    overlay:  { lastReportedState: 1, overlayOpen: true, adaptationComplete: true },
                    landing:  { lastReportedState: 4, landingOpen: true },
                    adapted:  { lastReportedState: 5, adaptationComplete: true }
                };
                var DEFAULT_VIEW = '{!JSENCODE($CurrentPage.parameters.view)}' || 'cold';
                var booted = false;
                function drive(view) {
                    try { f.contentWindow.postMessage(
                        { type: 'adaptive-restore-state', snapshot: VIEWS[view] || VIEWS.cold }, '*'); } catch (e) {}
                }
                window.addEventListener('message', function (ev) {
                    if (!ev.data) return;
                    if (ev.data.type === 'adaptive-sim-state') {
                        if (!booted) { booted = true; drive(DEFAULT_VIEW); }
                    } else if (ev.data.type === 'web-sim-drive') {
                        drive(ev.data.view);
                    } else if (ev.data.type === 'web-download') {
                        downloadHtml(lastHtml);
                    }
                });
            })
            .catch(function (e) { fail('Template load failed: ' + (e && e.message ? e.message : e)); });
    })();
</script>
</apex:page>
